backpagenew.com, www.backpagenew.com {
  encode zstd gzip
  @adminPages path /admin /admin/*
  redir @adminPages https://admin.backpagenew.com{uri} 302

  # Country blocking / Cloudflare-only gate (settings live in the admin panel).
  @internal path /api/internal/* /bpn-internal/*
  handle @internal {
    respond 404
  }
  @gated not path /_next/static/* /api/internal/* /bpn-internal/*
  forward_auth @gated api:4000 {
    uri /api/internal/geo-gate
    header_up X-Gate-App public
    lb_try_duration 5s
    lb_try_interval 250ms
  }
  # Do not advertise the software stack.
  header {
    -Via
    -X-Powered-By
    -X-Nextjs-Cache
    -X-Nextjs-Prerender
    -X-Nextjs-Stale-Time
    -X-Nextjs-Matched-Path
    defer
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  }

  handle_path /_next/static/* {
    root * /srv/static/public
    @found file {path}
    handle @found {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      header Cache-Control "no-store"
      respond "Asset not found" 404
    }
  }
  @api path /api/*
  handle @api {
    reverse_proxy api:4000 {
        header_up X-Backpagenew-App "public"
    }
  }
  handle {
    # Cloudflare may keep the home page and the country / state / city pickers for
    # 10 minutes (browsers always revalidate). Ad lists and ad pages are never stored.
    @shared path_regexp ^(/|/browse(/[^/]+){0,3}/?)$
    @live path_regexp ^/browse(/[^/]+){4,}
    header @shared Cache-Control "public, max-age=0, s-maxage=600, must-revalidate" {
      defer
    }
    header @live Cache-Control "no-store" {
      defer
    }
    @account path /auth /myaccount /myaccount/*
    header @account Cache-Control "private, no-store" {
      defer
    }
    reverse_proxy frontend:3000
  }
}

admin.backpagenew.com {
  encode zstd gzip

  # Country blocking / Cloudflare-only gate (settings live in the admin panel).
  @internal path /api/internal/* /bpn-internal/*
  handle @internal {
    respond 404
  }
  @gated not path /_next/static/* /api/internal/* /bpn-internal/*
  forward_auth @gated api:4000 {
    uri /api/internal/geo-gate
    header_up X-Gate-App admin
    lb_try_duration 5s
    lb_try_interval 250ms
  }
  # Do not advertise the software stack.
  header {
    -Via
    -X-Powered-By
    -X-Nextjs-Cache
    -X-Nextjs-Prerender
    -X-Nextjs-Stale-Time
    -X-Nextjs-Matched-Path
    defer
  }
  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Robots-Tag "noindex, nofollow"
  }
  handle_path /_next/static/* {
    root * /srv/static/admin
    @found file {path}
    handle @found {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      header Cache-Control "no-store"
      respond "Asset not found" 404
    }
  }
  @api path /api/*
  handle @api {
    reverse_proxy api:4000 {
        header_up X-Backpagenew-App "admin"
    }
  }
  handle {
    reverse_proxy admin:3001
  }
}
